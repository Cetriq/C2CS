{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2cs.dev/schema/0.2/common",
  "title": "C2CS 0.2 — shared definitions",
  "$defs": {
    "schemaVersion": { "const": "0.2" },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "claimId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "categoryName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "entityName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "namespacedIdentifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
    "claimRef": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}#[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "subject": {
      "type": "object",
      "properties": {
        "logical": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            },
            "required": ["path", "digest"],
            "additionalProperties": false
          }
        },
        "sbom": { "type": "string", "minLength": 1 }
      },
      "required": ["logical", "artifacts"],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "registry": { "$ref": "#/$defs/registryVersion" },
        "schema": { "$ref": "#/$defs/schemaVersion" }
      },
      "required": ["tool", "registry", "schema"],
      "additionalProperties": false
    },
    "contractRef": {
      "type": "object",
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["subject", "digest"],
      "additionalProperties": false
    },
    "noAssessmentQualifiers": {
      "$comment": "ADR-0001 invariant 1, mechanically checkable subset: content declared in a contract must not carry assessment-only qualifiers.",
      "allOf": [
        { "not": { "required": ["confidence"] } },
        { "not": { "required": ["source"] } },
        { "not": { "required": ["evidence"] } },
        { "not": { "required": ["first_seen"] } },
        { "not": { "required": ["last_seen"] } }
      ]
    }
  }
}
